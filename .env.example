APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Underscore form: en_AU resolves the lang/en_AU override directory
# (missing keys fall back to lang/en), en-AU would not.
APP_LOCALE=en_AU
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# The full key set is uncommented so a dev box's .env can't drift from
# the example (larascan's env-example-sync check); under sqlite only
# DB_CONNECTION and DB_DATABASE matter — the rest are inert until the
# connection flips to mysql/pgsql. Relative sqlite paths are anchored
# to the app root (config/database.php), so workers started outside
# the repo still find the file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Session payloads (flash data, CSRF tokens) encrypted at rest.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: leave unset over direct HTTPS (the cookie is marked
# secure on secure requests); set true when TLS terminates upstream.
# SESSION_SECURE_COOKIE=true

# CIDRs of reverse proxies whose X-Forwarded-* headers (proto, host,
# for) to trust — required for HSTS and secure cookies when TLS ends
# at a load balancer. Empty trusts nothing.
# TRUSTED_PROXIES=10.0.0.0/8

# Destination for `php artisan backup:create` (db dumps in db/, file
# archives in files/). Defaults to storage/app/backups when unset.
# BACKUP_PATH=/backups

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Cache-key prefix — the rate-limit counters ride the cache too. The
# default derives from APP_NAME so each app is distinct out of the
# box; when installations share one cache store, give each its own.
CACHE_PREFIX="${APP_NAME}_cache"
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


VITE_APP_NAME="${APP_NAME}"
