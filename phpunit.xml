<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!-- The three legacy reconciliation files drifted while the
                 whole directory was excluded (IFRS ledger expectations,
                 entry_type casing) — excluded per file so new
                 reconciliation coverage runs with the suite. -->
            <exclude>tests/Feature/Reconciliation/ReconciliationMatchingTest.php</exclude>
            <exclude>tests/Feature/Reconciliation/ReconciliationServiceTest.php</exclude>
            <exclude>tests/Feature/Reconciliation/AutoCreateCashReceiptTest.php</exclude>
        </testsuite>
        <!-- Shipped modules carry their tests with them; the suite runs
             with all shipped modules enabled. -->
        <testsuite name="Modules">
            <directory>Modules</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- Keep test-run log noise (expected posting failures etc.) out of
             the production laravel.log. -->
        <env name="LOG_CHANNEL" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value="/tmp/erp-phpunit.sqlite"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Dedicated compiled-view path: the shared storage cache is owned
             by the web user, and Blade's cache-refresh touch() on those
             files fails (utime) when tests run as a different user. -->
        <env name="VIEW_COMPILED_PATH" value="/tmp/erp-phpunit-views"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
