# Behat test environment — booted by Soulcodex\Behat (loadEnvironmentFrom('.env.behat')).
# APP_ENV=testing (not "behat") so VerifyCsrfToken's runningUnitTests() check
# skips CSRF for posted forms, matching phpunit behaviour. Separate file-based
# sqlite DB so scenarios can migrate:fresh without touching any other DB.
APP_NAME="Laravel ERP (Behat)"
APP_ENV=testing
APP_KEY=base64:xVt32wqrEYSlWdenk3Fx2BYszYzft4NhAYT3tAT2CHw=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/behat.sqlite

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=array
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
